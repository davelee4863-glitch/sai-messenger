# Preparation only. Build/runtime verification and any hosting require separate approval.
FROM node:22.23.2-bookworm-slim
WORKDIR /app/mvp
COPY mvp/package.json mvp/package-lock.json ./
RUN npm ci --ignore-scripts --no-fund --no-audit && groupadd --gid 10001 staging && useradd --uid 10001 --gid staging --no-create-home staging
COPY mvp/*.mjs mvp/*.sql ./
COPY mvp/client ./client
USER 10001:10001
ENV MVP_EXTERNAL_API=off
# No default public bind, database, allowed accounts, certificate or approved manifest.
CMD ["node", "server.mjs"]
